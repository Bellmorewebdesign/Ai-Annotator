# AI Annotator configuration.
# ./install.sh copies this file to .env (readable only by you). Fill in ANTHROPIC_API_KEY.
# .env is ignored by git. Never commit real keys. Lines starting with # are defaults/examples.

# --- Required ---------------------------------------------------------------------------------
# Anthropic API key (https://console.anthropic.com). Used only by the backend, never sent to browsers.
ANTHROPIC_API_KEY=

# --- AI ---------------------------------------------------------------------------------------
# Which AI backend to use. Currently: anthropic. ("fake" is a scripted client for automated tests and
# only works together with ANNOTATOR_ENV=test.) Local model servers are a planned option.
ANNOTATOR_AI_PROVIDER=anthropic
# Main model for document analysis and summaries.
ANNOTATOR_MODEL=claude-opus-5-5
# Model for short helper calls (detecting categories from instructions).
ANNOTATOR_LIGHT_MODEL=claude-opus-5-5
# Reasoning effort per call type: low | medium | high | xhigh | max
ANNOTATOR_ANALYSIS_EFFORT=high
ANNOTATOR_SUMMARY_EFFORT=medium
ANNOTATOR_LIGHT_EFFORT=low
# Retry a request on a fallback model if the main model declines it (server-side fallback).
ANNOTATOR_REFUSAL_FALLBACK=true
# Parallel AI requests (long documents are analysed in sections).
ANNOTATOR_AI_CONCURRENCY=3
# Attempts per AI request before giving up (rate limits, overload, network errors).
ANNOTATOR_AI_MAX_ATTEMPTS=5
# Upper bound on the length of one AI response, in tokens.
ANNOTATOR_AI_MAX_OUTPUT_TOKENS=64000
# Documents estimated above this many prompt tokens are planned first and analysed in sections.
ANNOTATOR_SINGLE_PASS_TOKEN_LIMIT=150000
ANNOTATOR_SECTION_TOKEN_TARGET=40000
# Prices (USD per million tokens) for cost estimates if you use a model not in the built-in table.
# ANNOTATOR_PRICE_INPUT_PER_MTOK=
# ANNOTATOR_PRICE_OUTPUT_PER_MTOK=

# --- Limits -----------------------------------------------------------------------------------
ANNOTATOR_MAX_UPLOAD_MB=50
ANNOTATOR_MAX_PAGES=50
ANNOTATOR_MAX_INSTRUCTION_MB=10
ANNOTATOR_MAX_INSTRUCTION_CHARS=20000

# --- Matching ---------------------------------------------------------------------------------
# Minimum similarity (0-100) to accept a quote that is not an exact match. Lower values accept more
# paraphrased quotes but risk imprecise highlights. Keep this high.
ANNOTATOR_FUZZY_ACCEPT_SCORE=95

# --- Storage and privacy ----------------------------------------------------------------------
# Where uploads, results and the job database are stored (default: ./data inside the project).
# ANNOTATOR_DATA_DIR=/srv/ai-annotator/data
# Hours to keep uploaded documents and results before automatic deletion (0 = keep forever).
ANNOTATOR_RETENTION_HOURS=72
# Keep intermediate files (extracted text, AI responses) after a job finishes. For debugging only.
ANNOTATOR_KEEP_WORK_FILES=false

# --- Worker -----------------------------------------------------------------------------------
ANNOTATOR_WORKER_POLL_SECONDS=1
# A job whose worker stops sending heartbeats for this long is picked up again.
ANNOTATOR_LEASE_SECONDS=60
ANNOTATOR_MAX_JOB_ATTEMPTS=3

# --- External tools ---------------------------------------------------------------------------
# Found automatically on PATH. Set these only if they are installed somewhere unusual.
# ANNOTATOR_TESSERACT_CMD=/usr/bin/tesseract
# ANNOTATOR_SOFFICE_CMD=/usr/bin/soffice
# Tesseract language(s), e.g. eng or eng+deu (install the matching tesseract-ocr-* package).
ANNOTATOR_OCR_LANGUAGE=eng

# --- API --------------------------------------------------------------------------------------
# Browser origins allowed to call the API. start.sh sets this automatically (including your network
# addresses with --lan); set it here only to override.
# ANNOTATOR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ANNOTATOR_LOG_LEVEL=INFO
# development | test | production. "test" enables the scripted AI client for automated tests.
ANNOTATOR_ENV=development

# --- Website ----------------------------------------------------------------------------------
# Where the browser reaches the backend. start.sh sets this; leave unset unless you run the parts
# yourself. When unset, the browser uses the address it opened the website with, on this port.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_PORT=8000
